datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  cargo     String   @default("ROTARIANO")
  createdAt DateTime @default(now())
}

model Evento {
  id        String   @id @default(uuid())
  titulo    String
  data      String
  local     String
}

model Post {
  id        String   @id @default(uuid())
  titulo    String
  conteudo  String
  createdAt DateTime @default(now())
}
